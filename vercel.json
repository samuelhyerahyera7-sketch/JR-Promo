{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/jsqr/dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/vendor/(.*)",
      "destination": "/api"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/intelligent-darwin-a9tafs": false
    }
  }
}
